{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SelekyT",
  "version": "0.3.0",
  "identifier": "com.selekyt.desktop",
  "mainBinaryName": "SelekyT",
  "build": {
    "frontendDist": "../web",
    "features": []
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "SelekyT",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "publisher": "SelekyT Project",
    "category": "Video",
    "copyright": "SelekyT Project",
    "shortDescription": "Local-first long-form to social video editorial engine",
    "longDescription": "SelekyT reasons like an experienced professional editor alongside a human editor with final creative authority. All transcription, analysis and rendering happen locally; no media leaves the machine.",
    "icon": [
      "src-tauri/icons/32x32.png",
      "src-tauri/icons/128x128.png",
      "src-tauri/icons/128x128@2x.png",
      "src-tauri/icons/icon.icns",
      "src-tauri/icons/icon.ico"
    ],
    "externalBin": [
      "binaries/selekyt-mech",
      "binaries/selekyt-python"
    ],
    "resources": {
      "resources/python": "python/",
      "resources/bin": "bin/",
      "resources/models": "models/",
      "resources/share": "share/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "exceptionDomain": "",
      "signingIdentity": null
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "src-tauri/icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "perMachine",
        "languages": ["en-US"],
        "displayLanguage": "en-US"
      },
      "wix": {
        "language": ["en-US"],
        "license": null,
        "template": null,
        "fragmentPaths": [],
        "componentRefs": [],
        "featureRefs": [],
        "merges": [],
        "skipWebviewInstall": false,
        "dialogImagePath": null,
        "bannerPath": null
      },
      "certificateThumbprint": null
    }
  },
  "plugins": {}
}
