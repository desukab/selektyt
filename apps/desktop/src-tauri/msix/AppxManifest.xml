<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX package manifest for the Store / sideload distribution path.

  VERIFICATION STATE, updated after each run of the `msix` CI job (the job is
  the only place this file is ever validated, since this host has no MakeAppx
  and no Windows SDK):

    * The structural contract it declares is pinned on this host by
      tests/test_desktop_packaging.py against tauri.conf.json: identity, version,
      executable name and every referenced asset all have to agree, and each PNG
      is round-trip decoded and compared pixel-for-pixel against the buffer that
      produced it.
    * Run `35553464487` was the first run to reach MakeAppx, and MakeAppx
      VALIDATED this manifest: schema, application identity and all six
      referenced assets were accepted. It then failed inside the writer for a
      reason unrelated to this file (a 32-bit MakeAppx against a 578 MB payload),
      so the pack never completed.
    * Run `35555583046` (commit `d428c78`) was the first GREEN `msix` job: 27m10s,
      both jobs 0 failed / 0 skipped, artifact
      `selekyt-windows-msix-unsigned-unverified`. MakeAppx ran with validation ON
      from `C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\makeappx.exe`
      and accepted this manifest. The artifact was then verified off the runner by
      enumerating its zip64 central directory (9552 entries, 2057.5 MiB
      uncompressed / 1525.2 MiB compressed): this manifest is present at 4704
      bytes with `Executable="SelekyT.exe"` unmodified — the committed copy and
      the installed payload agreed, so no correction warning fired — and
      `[Content_Types].xml`, `AppxBlockMap.xml`, `SelekyT.exe` (4791296 bytes)
      and all six referenced assets are in the package. Identity cross-checked
      against tauri.conf.json: Name `SelekyT` == productName, Version `0.3.0.0`
      == version `0.3.0`, Publisher `CN=SelekyT Project` == bundle publisher,
      `SelekyT.exe` == mainBinaryName. Every field agrees.
    * What no run has established: that the package installs, that the app
      starts under the full-trust activation, that the tile and splash appear, or
      that Partner Center accepts a submission. The pack being green means the
      manifest is schema-valid and the layout is MakeAppx's own output;
      schema-valid is not installable, and this host has no Windows machine to
      install on. Only a Store submission validates the 720x1080 store logo.
    * Payload note, observed in the green artifact: the whisper `small` weights
      were in the package three times byte-for-byte (crc32 `81093b67`,
      483546902 bytes each) — the snapshot file, the repo blob, and a
      `models/hub/blobs/` copy. That was 922 MiB of redundant payload in a
      2058 MiB package, a staging-layout question rather than a manifest one.
      Fixed in `stage-windows.sh` (collapse of the cache to one real file per
      snapshot entry); this manifest carries no weights, so the fix is visible
      here only as a smaller package on the next green artifact.

  How the payload is built: apps/desktop/package-msix.ps1 runs the NSIS
  installer produced by `tauri build` (bundles: nsis) silently into an empty
  directory and packs *that*. The MSIX payload is therefore the layout a user's
  machine ends up with, rather than a hand-assembled guess at where Tauri
  places the sidecars and resources — that guess is the part that could not be
  checked from Linux.

  Activation: the combination below is docs combination #3
  (Executable + EntryPoint="windows.fullTrustApplication"), which is equivalent
  to uap10:RuntimeBehavior="packagedClassicApp" + uap10:TrustLevel="mediumIL".
  The uap10 attributes only exist from 10.0.19041, so this manifest targets
  10.0.17763 and uses the EntryPoint form that 17763 understands. Specifying
  both forms at once is an error if they contradict, so only one appears.

  Identity notes for whoever signs this later:
    * Publisher MUST equal the certificate's subject exactly, including the
      "CN=" prefix, or the package will not install even with a valid cert.
      It is a plain display name today because no certificate exists; an
      unsigned MSIX will not install without developer mode or sideloading, and
      this manifest does not pretend otherwise.
    * Name is the first half of the package family name. Once published it
      cannot change without a new Store listing.
    * MakeAppx checks that every image referenced below exists in the payload;
      it does NOT check image dimensions. The sizes emitted by
      icons/make_icons.py match Microsoft's published scale-100 sizes for each
      attribute, and the Store listing logo is 720x1080, but only a submission
      to Partner Center actually validates the latter.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="SelekyT"
            Publisher="CN=SelekyT Project"
            Version="0.3.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SelekyT</DisplayName>
    <PublisherDisplayName>SelekyT Project</PublisherDisplayName>
    <Description>Local-first long-form to social video editorial engine</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <!-- Desktop bridge: a full-trust converted Win32 app, which is what a
         Tauri shell that spawns sidecars and reads the filesystem has to be.
         17763 is the first build carrying the full-trust capability set. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Applications>
    <Application Id="SelekyT"
                 Executable="SelekyT.exe"
                 EntryPoint="windows.fullTrustApplication">
      <uap:VisualElements
        DisplayName="SelekyT"
        Description="Local-first long-form to social video editorial engine"
        BackgroundColor="#101318"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square310x310Logo="Assets\Square310x310Logo.png"
                         Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust is what makes this a full-trust packaged app rather than a
         sandboxed one; broadFileSystemAccess is why the app may read media
         anywhere on disk instead of only under its own install directory. -->
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="broadFileSystemAccess" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
