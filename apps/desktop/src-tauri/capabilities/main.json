{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "SelekyT desktop shell: local filesystem access for the user's own media and outputs, plus execution of exactly the two bundled sidecars (the Rust mechanical core `selekyt-mech` and the bundled Python interpreter that hosts the intelligence layer). No network, no arbitrary shell execution. ffmpeg/ffprobe are invoked by the Python sidecar over PATH, never by the webview.",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$VIDEO/**" },
        { "path": "$AUDIO/**" },
        { "path": "$PICTURE/**" },
        { "path": "$RESOURCE/**" }
      ],
      "deny": [
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.config/keys/**" },
        { "path": "$APPDATA/*/Network/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$VIDEO/**" },
        { "path": "$AUDIO/**" },
        { "path": "$LOG/**" },
        { "path": "$TEMP/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$RESOURCE/**" }
      ]
    },
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-copy-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/selekyt-mech", "sidecar": true, "args": true },
        { "name": "binaries/selekyt-python", "sidecar": true, "args": true }
      ]
    },
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-stderr-read",
    "shell:allow-stdout-read",
    "shell:allow-kill",
    "shell:allow-terminate"
  ]
}
