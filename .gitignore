# Windows desktop staging: apps/desktop/stage-windows.sh downloads an
# interpreter, ffmpeg and the whisper weights (~1 GB total) into these trees.
# None of it is source, and committing it would make the repo unclonable.
apps/desktop/src-tauri/resources/python/
apps/desktop/src-tauri/resources/bin/
apps/desktop/src-tauri/resources/models/
apps/desktop/src-tauri/.stage-downloads/
apps/desktop/src-tauri/.launcher-build/
# Host-specific dev sidecar wrappers (`selekyt-python-<host-triple>`); a packaged
# build replaces them with staged binaries, so nothing here is portable.
apps/desktop/src-tauri/binaries/

# Corpus: the evidence is the text artifacts (transcript, selections, edit
# plan, captions, timelines, QA). The rendered MP4s, extracted WAVs and the
# downloaded source media are regenerable from corpus/manifest.json by
# tools/corpus_run.py, and committing ~400 MB of binary per run makes the
# repo unclonable for no evidentiary gain.
corpus/media/

# WER scratch (tools/wer_bench.py): ground-truth audio, downloaded corpus
# tarballs, cached PCM, and model weights live here — several GB of regenerable
# binary. The run records under corpus/wer/runs/ ARE the evidence and stay in,
# as does the manifest: it is 50 lines of text naming the exact utterances and
# reference transcripts the measured WER was scored against, so the number can
# be audited without a 346 MB download. `tools/wer_bench.py fetch` rebuilds it.
corpus/wer/*
!corpus/wer/runs/
# Every WER corpus directory contributes the same two text files, and a number
# scored against a manifest that is not committed is not auditable. Naming each
# corpus here was already the wrong shape once the second corpus landed.
!corpus/wer/*/
corpus/wer/*/*
!corpus/wer/*/manifest.jsonl
!corpus/wer/*/provenance.json
# The run records are the evidence. `corpus/wer/*/*` above reaches into runs/
# too, so this has to come after it at file level or a new record cannot be
# added while the ones already in the index stay tracked — a trap that only
# shows up on a new corpus's first commit.
!corpus/wer/runs/
!corpus/wer/runs/*

corpus/*_run/project/facebook/
corpus/*_run/project/shorts/
corpus/*_run/project/source/
corpus/*_run/project/transcription/audio.wav
corpus/*_run/project/transcription/chunks/*.wav

# tools/microbench.py output: decoded WAVs, re-rendered MP4s and the
# per-run whisper chunk checkpoints. All regenerable from the committed
# transcript/selections plus local media; the numbers belong in
# docs/TIME_SAVINGS.md §2a/§2b, not in the tree.
corpus/*_run/project/transcription/microbench.wav
corpus/*_run/project/transcription/transcription/
corpus/*_run/project/microbench_*/

# MLS/WER progress logs: transient stdout from the streaming prepare and bench.
# The evidence is the run record (corpus/wer/runs/<tag>.json) and the manifest
# beside it, which together reproduce the number; the log is just the terminal
# scrollback of producing it.
corpus/wer_*.log
corpus/rerun_*.log
